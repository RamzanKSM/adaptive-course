# Copy to .env and choose a local administrator password. Never commit .env.
APP_BOOTSTRAP_ADMIN_LOGIN=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=
# false for local HTTP. Set true behind an HTTPS reverse proxy on a VPS.
APP_COOKIE_SECURE=false

# Codex App Server is opt-in. Keep both flags false until the target Linux
# sandbox has passed the documented student-input denial checks.
APP_LLM_ENABLED=false
APP_LLM_STUDENT_RUNTIME_VALIDATED=false
CODEX_MODEL=gpt-6-luna
# Fallback reasoning level; per purpose: task generation high, chat low, explanations medium.
CODEX_REASONING_EFFORT=medium
CODEX_REASONING_EFFORT_TASK=high
CODEX_REASONING_EFFORT_CHAT=low
CODEX_REASONING_EFFORT_EXPLANATION=medium
# Change after switching the host-side ChatGPT/Codex account.
CODEX_ACCOUNT_NAMESPACE=default
