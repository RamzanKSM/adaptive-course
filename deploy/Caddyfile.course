# Append this fragment to the VPS Caddyfile.
# It is intentionally not a complete Caddyfile and does not modify other hosts.
http://course.rmzn.net {
    # The existing global default_bind is 127.0.0.1; HTTP must be public to redirect.
    bind 0.0.0.0
    redir https://{host}{uri} permanent
}

https://course.rmzn.net {
    reverse_proxy 127.0.0.1:8080
}
